.page { min-height: 100vh; padding: 28rpx; background: #f3f5f7; box-sizing: border-box; color: #17212b; }
.header { margin-bottom: 22rpx; }
.header__title { font-size: 40rpx; font-weight: 700; }
.header__meta, .event__time, .event__sync { color: #6a7580; font-size: 23rpx; }
.event { display: grid; grid-template-columns: 190rpx 1fr; gap: 18rpx; padding: 20rpx 0; border-top: 1rpx solid #d5dce2; }
.event__image { width: 190rpx; height: 130rpx; background: #d9dee3; }
.event__title { font-size: 29rpx; font-weight: 650; }
.event__metrics { margin: 8rpx 0; font-size: 24rpx; line-height: 1.5; }
.event button { margin: 10rpx 0 0; }
.empty { padding: 80rpx 0; text-align: center; color: #74808b; }
