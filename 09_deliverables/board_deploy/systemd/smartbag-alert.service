[Unit]
Description=SS928 SmartBag dual-camera alert and hardware controller
After=smartbag-ws73.service bluetooth.service network.target smartbag-connectivity.service
Wants=smartbag-ws73.service bluetooth.service network.target smartbag-connectivity.service
Conflicts=smartbag-vision.service

[Service]
Type=simple
RuntimeDirectory=smartbag
WorkingDirectory=/root/smartbag/controller
EnvironmentFile=-/etc/smartbag/smartbag.env
ExecStartPre=/root/smartbag/apply-smartbag-pinmux.sh
ExecStart=/usr/bin/python3 /root/smartbag/controller/smartbag_alert_controller.py --config /etc/smartbag/config.json --detector-cwd /root/smartbag/vision
ExecStopPost=/root/smartbag/safe-off.sh
Restart=on-failure
RestartSec=2
KillMode=control-group
TimeoutStopSec=10

[Install]
WantedBy=smartbag.target
