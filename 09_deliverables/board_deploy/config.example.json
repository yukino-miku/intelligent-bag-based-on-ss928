{
  "runtime_mode": "radar_primary_visual_classification",
  "paths": {
    "python": "/usr/bin/python3",
    "vision": "/root/smartbag/vision",
    "model": "/root/smartbag/models/vehicle-detector.om"
  },
  "controller_status_file": "/run/smartbag/controller-status.json",
  "detector_restart": {
    "limit": 5,
    "backoff_s": 1.0
  },
  "cameras": {
    "left": {
      "camera_device": "/dev/smartbag-camera-left",
      "detector_profile": "board_dual_balanced",
      "calibration_file": "/etc/smartbag/calibration-left.json",
      "camera_height": 1.2,
      "camera_pitch": 5.0,
      "camera_fps": 30,
      "inference_fps_limit": 8,
      "process_every_n": 1,
      "camera_reconnect_attempts": 5,
      "camera_reconnect_backoff_s": 0.5,
      "alert_min_level": 1,
      "alert_rate_limit_s": 0.25,
      "jpeg_stream_width": 480,
      "jpeg_stream_height": 360,
      "jpeg_quality": 70,
      "stream_fps_limit": 8,
      "stream_port": 18081,
      "risk_log_csv": "/var/log/smartbag/risk-left.csv",
      "pwm_channels": ["left_1", "left_2"]
    },
    "right": {
      "camera_device": "/dev/smartbag-camera-right",
      "detector_profile": "board_dual_balanced",
      "calibration_file": "/etc/smartbag/calibration-right.json",
      "camera_height": 1.2,
      "camera_pitch": 5.0,
      "camera_fps": 30,
      "inference_fps_limit": 8,
      "process_every_n": 1,
      "camera_reconnect_attempts": 5,
      "camera_reconnect_backoff_s": 0.5,
      "alert_min_level": 1,
      "alert_rate_limit_s": 0.25,
      "jpeg_stream_width": 480,
      "jpeg_stream_height": 360,
      "jpeg_quality": 70,
      "stream_fps_limit": 8,
      "stream_port": 18082,
      "risk_log_csv": "/var/log/smartbag/risk-right.csv",
      "pwm_channels": ["right_1", "right_2"]
    }
  },
  "stream_gateway": {
    "bind": "0.0.0.0",
    "port": 8080,
    "access_token": ""
  },
  "snapshot_classifier": {
    "enabled": true,
    "backend": "ss928_om",
    "model": "/root/smartbag/models/vehicle-detector.om",
    "runner": "/root/smartbag/vision/ss928_backend/bin/ss928_detection_runner",
    "imgsz": 640,
    "confidence": 0.25,
    "max_det": 30,
    "target_classes": ["bicycle", "motorcycle", "car", "truck", "bus"],
    "target_switch_interval_s": 0.2,
    "initial_warmup_frames": 2,
    "switch_warmup_frames": 0,
    "capture_frames": 1,
    "capture_timeout_ms": 1000,
    "streamoff_timeout_ms": 1000,
    "camera_reset_backoff_s": 1.0,
    "inference_timeout_ms": 5000,
    "snapshot_interval_ms": 0,
    "left_device": "/dev/smartbag-camera-left",
    "right_device": "/dev/smartbag-camera-right"
  },
  "fusion": {
    "left_calibration": "/etc/smartbag/fusion-left.json",
    "right_calibration": "/etc/smartbag/fusion-right.json",
    "association_max_time_delta_s": 0.20,
    "projection_half_width_px": 80,
    "projection_half_width_ratio": 0.04,
    "bbox_expand_ratio": 0.25,
    "max_center_distance_px": 180,
    "max_association_cost": 1.0,
    "ambiguity_cost_gap": 0.05,
    "visual_class_max_age_s": 1.5,
    "risk_window_s": 0.5,
    "warning_sensitivity": 1.0,
    "min_samples_per_window": 3,
    "min_observed_duration_s": 0.25,
    "min_complete_scan_ratio": 0.67,
    "min_radar_quality": 0.5,
    "radar_track_timeout_s": 0.8,
    "radar_max_missed_scans": 3,
    "event_rate_limit_s": 0.25,
    "record_dir": "/var/log/smartbag/fusion",
    "runtime_tuning_path": "/etc/smartbag/runtime-tuning.json",
    "alert_history_root": "/var/lib/smartbag/alarm-events",
    "max_alarm_snapshot_age_s": 2.0,
    "frame_cache_per_side": 12,
    "max_board_events": 500,
    "max_board_images": 200,
    "max_board_storage_mb": 256,
    "retention_days": 30,
    "worker_monitor_interval_s": 0.5,
    "worker_restart_initial_backoff_s": 0.5,
    "worker_restart_max_backoff_s": 8.0,
    "debug_http_enabled": true,
    "debug_bind": "127.0.0.1",
    "debug_port": 8080,
    "debug_access_token": ""
  },
  "risk": {
    "vehicle_risk_multipliers": {
      "bicycle": 0.92,
      "motorcycle": 0.96,
      "car": 1.0,
      "truck": 1.1,
      "bus": 1.1,
      "unknown": 1.0
    }
  },
  "pwm": {
    "period_ns": 1000000,
    "level_duty_percent": {
      "0": [0, 0],
      "1": [60, 0],
      "2": [60, 60],
      "3": [100, 60],
      "4": [100, 100]
    }
  },
  "outputs": {
    "haptics_backend": "tm6605",
    "i2c_device": "/dev/i2c-0",
    "tm6605_mux_address": "0x70",
    "bmi270_mux_channel": 0,
    "left_tm6605_channel": 1,
    "right_tm6605_channel": 2,
    "tm6605_connected_sides": ["left", "right"],
    "lights_enabled": true
  },
  "radar": {
    "enabled": true,
    "config": "/etc/smartbag/mr20.json"
  },
  "modules": {
    "gnss": {
      "enabled": false,
      "command": "/usr/bin/python3 /root/smartbag/gnss/dx_gp21_tracker.py --config /root/smartbag/gnss/config.ss928_uart4.json --command-stdin --no-ble"
    },
    "imu": {
      "enabled": true,
      "command": "/usr/bin/python3 /root/smartbag/imu/bmi270_backpack.py --config /etc/smartbag/bmi270.json --command-stdin --no-ble"
    }
  },
  "timing": {
    "event_timeout_s": 1.0,
    "max_event_age_s": 2.0
  },
  "posture_reminder": {
    "enabled": true,
    "level": 1,
    "duration_s": 5.0,
    "audio_clip": "bad"
  },
  "audio": {
    "enabled": false,
    "root": "/root/smartbag/audio"
  },
  "ble": {
    "name": "SS928-SmartBag"
  }
}
