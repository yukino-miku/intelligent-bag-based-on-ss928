# Keep this file root-owned and mode 0600 after copying to /etc/smartbag/smartbag.env.
# install.sh replaces empty API tokens with cryptographically random values.
SMARTBAG_API_TOKEN=
SMARTBAG_API_READONLY_TOKEN=
SMARTBAG_CONNECTIVITY_ENABLED=0
SMARTBAG_MT5710_PORT=/dev/ttyUSB1
WS73_MODULE_DIR=/opt/sample/ws73
SMARTBAG_UPLOAD_TOKEN=
SMARTBAG_FALL_PHONE=
